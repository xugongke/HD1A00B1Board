#Generating source browse information for project ek_stm8_template


#Abbreviations
cc = E$:\IARSTM8\common\bin\SourceIndexer.exe
ll = E$:\IARSTM8\common\bin\PbdLink.exe
bd = E$:\IARSTM8\common\bin\makeBrowseData.exe



#Rules
rule index
  depfile = $out.dep
  command = $cc -out=$out -f $in
rule link
  command = $ll -M $out $in
rule browsedata
  command = $bd $in -output  $out



#Build steps
build ek_clk.pbi : index ek_clk.xcl
build ek_gpio.pbi : index ek_gpio.xcl
build ek_tim.pbi : index ek_tim.xcl
build ek_uart.pbi : index ek_uart.xcl
build es1642.pbi : index es1642.xcl
build es1642_port_stm8.pbi : index es1642_port_stm8.xcl
build heater_ctrl.pbi : index heater_ctrl.xcl
build main.pbi : index main.xcl
build stm8s_it.pbi : index stm8s_it.xcl
build stm8s_adc1.pbi : index stm8s_adc1.xcl
build stm8s_clk.pbi : index stm8s_clk.xcl
build stm8s_gpio.pbi : index stm8s_gpio.xcl
build stm8s_itc.pbi : index stm8s_itc.xcl
build stm8s_iwdg.pbi : index stm8s_iwdg.xcl
build stm8s_tim2.pbi : index stm8s_tim2.xcl
build stm8s_uart1.pbi : index stm8s_uart1.xcl
build ek_stm8_template_part0.pbi : link ek_clk.pbi ek_gpio.pbi ek_tim.pbi ek_uart.pbi
build ek_stm8_template_part1.pbi : link es1642.pbi es1642_port_stm8.pbi heater_ctrl.pbi main.pbi
build ek_stm8_template_part2.pbi : link stm8s_it.pbi stm8s_adc1.pbi stm8s_clk.pbi stm8s_gpio.pbi
build ek_stm8_template_part3.pbi : link stm8s_itc.pbi stm8s_iwdg.pbi stm8s_tim2.pbi stm8s_uart1.pbi
build ek_stm8_template.pbd : link ek_stm8_template_part0.pbi ek_stm8_template_part1.pbi ek_stm8_template_part2.pbi ek_stm8_template_part3.pbi
build ek_stm8_template.pbw : browsedata ek_stm8_template.pbd


