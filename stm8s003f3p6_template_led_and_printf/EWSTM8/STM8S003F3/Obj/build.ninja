#Generating source browse information for project ek_stm8_template


#Abbreviations
cc = E$:\IARSTM8\common\bin\SourceIndexer.exe
ll = E$:\IARSTM8\common\bin\PbdLink.exe
bd = E$:\IARSTM8\common\bin\makeBrowseData.exe



#Rules
rule index
  depfile = $out.dep
  command = $cc -out=$out -f $in
rule link
  command = $ll -M $out $in
rule browsedata
  command = $bd $in -output  $out



#Build steps
build ek_clk.pbi : index ek_clk.xcl
build ek_gpio.pbi : index ek_gpio.xcl
build ek_tim.pbi : index ek_tim.xcl
build ek_uart.pbi : index ek_uart.xcl
build es1642.pbi : index es1642.xcl
build es1642_port_stm8.pbi : index es1642_port_stm8.xcl
build main.pbi : index main.xcl
build stm8s_it.pbi : index stm8s_it.xcl
build stm8s_adc1.pbi : index stm8s_adc1.xcl
build stm8s_awu.pbi : index stm8s_awu.xcl
build stm8s_beep.pbi : index stm8s_beep.xcl
build stm8s_clk.pbi : index stm8s_clk.xcl
build stm8s_exti.pbi : index stm8s_exti.xcl
build stm8s_flash.pbi : index stm8s_flash.xcl
build stm8s_gpio.pbi : index stm8s_gpio.xcl
build stm8s_i2c.pbi : index stm8s_i2c.xcl
build stm8s_itc.pbi : index stm8s_itc.xcl
build stm8s_iwdg.pbi : index stm8s_iwdg.xcl
build stm8s_rst.pbi : index stm8s_rst.xcl
build stm8s_spi.pbi : index stm8s_spi.xcl
build stm8s_tim1.pbi : index stm8s_tim1.xcl
build stm8s_tim2.pbi : index stm8s_tim2.xcl
build stm8s_tim4.pbi : index stm8s_tim4.xcl
build stm8s_uart1.pbi : index stm8s_uart1.xcl
build stm8s_wwdg.pbi : index stm8s_wwdg.xcl
build ek_stm8_template_part0.pbi : link ek_clk.pbi ek_gpio.pbi ek_tim.pbi ek_uart.pbi es1642.pbi
build ek_stm8_template_part1.pbi : link es1642_port_stm8.pbi main.pbi stm8s_it.pbi stm8s_adc1.pbi stm8s_awu.pbi
build ek_stm8_template_part2.pbi : link stm8s_beep.pbi stm8s_clk.pbi stm8s_exti.pbi stm8s_flash.pbi stm8s_gpio.pbi
build ek_stm8_template_part3.pbi : link stm8s_i2c.pbi stm8s_itc.pbi stm8s_iwdg.pbi stm8s_rst.pbi stm8s_spi.pbi
build ek_stm8_template_part4.pbi : link stm8s_tim1.pbi stm8s_tim2.pbi stm8s_tim4.pbi stm8s_uart1.pbi stm8s_wwdg.pbi
build ek_stm8_template.pbd : link ek_stm8_template_part0.pbi ek_stm8_template_part1.pbi ek_stm8_template_part2.pbi ek_stm8_template_part3.pbi ek_stm8_template_part4.pbi
build ek_stm8_template.pbw : browsedata ek_stm8_template.pbd


